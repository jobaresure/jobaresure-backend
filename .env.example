# ===================================================================
# Jobaresure backend environment variables
# Copy to a .env file (or export in your shell / run config) and fill in.
# Spring reads these via ${VAR} placeholders in application.properties.
# ===================================================================

# ---- Server ----
SERVER_PORT=8080

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/job_dev?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=password
# local dev: update | production: validate (then apply resources/*.sql)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ---- JWT / Auth ----
# MUST be at least 32 characters (256 bits) for HS256.
JWT_SECRET=change-me-in-production-this-must-be-at-least-32-bytes-long-secret
JWT_ACCESS_EXPIRATION_MS=900000          # 15 minutes
JWT_REFRESH_EXPIRATION_MS=1209600000     # 14 days
JWT_ISSUER=jobaresure

# ---- CORS (your Lovable / Vite frontend origins, comma-separated) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate limiting (auth & otp endpoints, per IP) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_TOKENS=20
RATE_LIMIT_REFILL_PERIOD_SECONDS=60

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---- SMS provider: mock | msg91 ----
SMS_PROVIDER=mock
MSG91_BASE_URL=https://control.msg91.com/api/v5
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=JOBSUR

# ---- Email provider: mock | smtp (verification & password-reset codes) ----
# mock logs the code to the application console (perfect for local dev).
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=no-reply@jobaresure.com
EMAIL_FROM_NAME=Jobaresure
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- AI (Claude / Anthropic) — used by later phases ----
AI_PROVIDER=claude
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096

# ---- File storage (Supabase Storage) — used by later phases ----
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=jobaresure

# ---- Payments (Razorpay) — used by later phases ----
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- OpenAPI ----
OPENAPI_SERVER_URL=http://localhost:8080
