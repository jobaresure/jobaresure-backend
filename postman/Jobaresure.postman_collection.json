{
  "info": {
    "name": "Jobaresure API",
    "_postman_id": "b1f2c3d4-0001-4a2b-9c3d-jobaresure0001",
    "description": "REST API collection for the Jobaresure employment platform.\n\nBase URL is the `{{baseUrl}}` variable (default http://localhost:8080).\n\nAuthentication: most endpoints use Bearer JWT. Run **Auth > Login** (or a Register request) first — its test script auto-saves `accessToken` and `refreshToken` into collection variables, and every protected request inherits the Bearer token automatically. Public endpoints override auth to `noauth`.\n\nCreate requests (organization, employer, job, application, verification, skill) save the returned id/publicId into collection variables so you can chain calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "orgId", "value": "" },
    { "key": "employerId", "value": "" },
    { "key": "jobPublicId", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "verificationId", "value": "" },
    { "key": "skillId", "value": "" },
    { "key": "experienceId", "value": "" },
    { "key": "educationId", "value": "" },
    { "key": "applicantSkillId", "value": "" }
  ],
